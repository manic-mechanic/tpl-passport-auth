BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=https://auth.librarypassport.ca
GOOGLE_CLIENT_ID=          # from Google Cloud Console (same as web app)
GOOGLE_CLIENT_SECRET=      # from Google Cloud Console (same as web app)
TURSO_DATABASE_URL=        # libsql://... (same as web app)
TURSO_AUTH_TOKEN=          # from Turso dashboard (same as web app)
R2_ACCOUNT_ID=             # Cloudflare account ID (dashboard sidebar)
R2_ACCESS_KEY_ID=          # R2 API token → Create API Token → R2 Token
R2_SECRET_ACCESS_KEY=      # R2 API token secret
R2_PUBLIC_URL=             # https://pub-<hash>.r2.dev or custom domain (no trailing slash)